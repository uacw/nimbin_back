            },
            "url": {
              "raw": "{{base_url}}/api/pastes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pastes"
              ]
            },
            "description": "Создает unlisted заметку с датой истечения."
          },
          "response": []
        },

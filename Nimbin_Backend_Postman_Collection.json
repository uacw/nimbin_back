            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Приватная заметка\",\n    \"content\": \"Это приватная заметка, видна только мне\",\n    \"syntaxLanguage\": \"kotlin\",\n    \"visibility\": \"PRIVATE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pastes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pastes"
              ]
            },
            "description": "Создает приватную заметку, доступную только автору."
          },
          "response": []
        },
        {
          "name": "Создать unlisted заметку с истечением",

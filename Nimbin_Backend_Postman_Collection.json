              "if (json && json.id) pm.collectionVariables.set('paste_id', json.id);"
            ] } }
          ]
        },
        {
          "name": "Получить заметку по ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/pastes/{{paste_id}}", "host": ["{{base_url}}"], "path": ["api","pastes","{{paste_id}}"] },
            "description": "Получает заметку по ID. Увеличивает счетчик просмотров."
          },
          "response": [],
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const etag = pm.response.headers.get('ETag');",
              "if (etag) pm.collectionVariables.set('etag', etag.replace(/\"/g, ''));"
            ] } }
          ]
        },
        {
          "name": "Редактировать заметку (If-Match)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "If-Match", "value": "\"{{etag}}\"" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content\",\n  \"syntaxLanguage\": \"kotlin\",\n  \"visibility\": \"PUBLIC\"\n}" },
            "url": { "raw": "{{base_url}}/api/pastes/{{paste_id}}", "host": ["{{base_url}}"], "path": ["api","pastes","{{paste_id}}"] },
            "description": "Редактирует заметку с ETag через If-Match. Сначала выполните GET /api/pastes/{{paste_id}} — ETag сохранится в {{etag}}."
          },
          "response": []
        },

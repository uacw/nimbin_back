            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "description": "Регистрация с заголовком Authorization гостевого токена. Выполняет миграцию pastes и избранного на новый user_id."
          },
          "response": [],
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json && json.token) pm.collectionVariables.set('jwt_token', json.token);",
              "if (json && json.user && json.user.id) pm.collectionVariables.set('user_id', json.user.id);"
            ] } }
          ]
        },
        {

{
  "info": {
    "_postman_id": "nimbin-backend-api",
    "name": "Nimbin Backend API",
    "description": "Полная коллекция тестов для Nimbin Backend API - Pastebin клон на Kotlin/Ktor.\n\nПереключение окружений: установите переменную коллекции run_env = 'local' или 'heroku'. Скрипт коллекции автоматически подставит {{base_url}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "run_env", "value": "local" },
    { "key": "local_url", "value": "http://localhost:8080" },
    { "key": "heroku_url", "value": "https://nimbin-back-1de949af6629.herokuapp.com" },
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "jwt_token", "value": "" },
    { "key": "guest_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "paste_id", "value": "" },
    { "key": "etag", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const env = (pm.collectionVariables.get('run_env') || 'local').toLowerCase();",
          "const local = pm.collectionVariables.get('local_url') || 'http://localhost:8080';",
          "const heroku = pm.collectionVariables.get('heroku_url') || pm.collectionVariables.get('base_url') || 'https://nimbin-back-1de949af6629.herokuapp.com';",
          "const chosen = env === 'local' ? local : heroku;",
          "pm.variables.set('base_url', chosen);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "🔑 Аутентификация",
      "item": [
        {
          "name": "Регистрация нового пользователя",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"test_user_{{$timestamp}}\",\n    \"email\": \"test{{$timestamp}}@example.com\",\n    \"password\": \"secure123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "description": "Создает новый аккаунт пользователя. Возвращает JWT токен и данные пользователя."
          },
          "response": [],
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json && json.token) pm.collectionVariables.set('jwt_token', json.token);",
              "if (json && json.user && json.user.id) pm.collectionVariables.set('user_id', json.user.id);"
            ] } }
          ]
        },
        {
          "name": "Регистрация (��играция гостя)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },

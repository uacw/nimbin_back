            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n    \"title\": \"Тестовая заметка с кириллицей\",\n    \"content\": \"Привет мир! Это тестовая заметка на русском языке.\\nПоддерживаются переносы строк и специальные символы: àáâãäåæç\",\n    \"syntaxLanguage\": \"plaintext\",\n    \"visibility\": \"PUBLIC\"\n}" },
            "url": { "raw": "{{base_url}}/api/pastes", "host": ["{{base_url}}"], "path": ["api","pastes"] },
            "description": "Создает публичную заметку от имени аутентифицированного пользователя."
          },
          "response": [],
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json && json.id) pm.collectionVariables.set('paste_id', json.id);"
            ] } }
          ]
        },
        {
          "name": "Создать приватную заметку",
          "request": {
            "method": "POST",
            "header": [

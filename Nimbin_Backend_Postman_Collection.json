{
  "info": {
    "_postman_id": "nimbin-backend-api",
    "name": "Nimbin Backend API",
    "description": "Полная коллекция тестов для Nimbin Backend API - Pastebin клон на Kotlin/Ktor.\n\nПереключение окружений: установите переменную коллекции run_env = 'local' или 'heroku'. Скрипт коллекции автоматически подставит {{base_url}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const env = (pm.collectionVariables.get('run_env') || 'local').toLowerCase();",
          "const local = pm.collectionVariables.get('local_url') || 'http://localhost:8080';",
          "const heroku = pm.collectionVariables.get('heroku_url') || pm.collectionVariables.get('base_url') || 'https://nimbin-back-1de949af6629.herokuapp.com';",
          "const chosen = env === 'local' ? local : heroku;",
          "pm.variables.set('base_url', chosen);"
        ]
      }
    }
  ],

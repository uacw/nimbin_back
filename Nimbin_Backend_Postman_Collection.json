          "name": "Создать анонимную заметку",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n    \"title\": \"Анонимная заметка\",\n    \"content\": \"Эта заметка создана без аутентификации\",\n    \"syntaxLanguage\": \"plaintext\",\n    \"visibility\": \"PUBLIC\"\n}" },
            "url": { "raw": "{{base_url}}/api/pastes", "host": ["{{base_url}}"], "path": ["api","pastes"] },
            "description": "Создает анонимную заметку без авторизации."
          },
          "response": [],
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
